# API base URL backend'а (FastAPI, TIER 7)
VITE_API_BASE_URL=http://localhost:8000

# Включить Demo Mode по умолчанию (true/false)
VITE_DEFAULT_DEMO=true

# Токен бота (только backend; никогда не попадает во фронтенд)
BOT_TOKEN=

# PostgreSQL (docker compose). Пароль ниже — локальный default, не для production.
POSTGRES_USER=gram
POSTGRES_PASSWORD=gram
POSTGRES_DB=gram
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://gram:gram@127.0.0.1:5432/gram

APP_ENV=development
API_PORT=8000
CORS_ORIGINS=http://localhost:4173,http://localhost:5173,http://127.0.0.1:4173
